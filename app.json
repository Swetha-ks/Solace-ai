{
  "expo": {
    "name": "Solace AI",
    "slug": "solace-ai",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.solaceai.app",
      "buildNumber": "3",
      "infoPlist": {
        "NSSpeechRecognitionUsageDescription": "Allow $(PRODUCT_NAME) to use speech recognition.",
        "NSMicrophoneUsageDescription": "Allow $(PRODUCT_NAME) to use the microphone."
      }
    },
    "android": {
      "package": "com.solaceai.app",
      "versionCode": 8,
      "permissions": [
        "SCHEDULE_EXACT_ALARM",
        "android.permission.RECORD_AUDIO"
      ],
      "adaptiveIcon": {
        "backgroundColor": "#FDF9F3",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      }
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-font",
      [
        "expo-notifications",
        {
          "icon": "./assets/android-icon-monochrome.png",
          "color": "#B0664A",
          "defaultChannel": "gentle-reminders",
          "enableRemoteNotifications": false
        }
      ],
      "expo-speech-recognition",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#FDF9F3",
          "image": "./assets/splash-icon.png",
          "imageWidth": 210,
          "resizeMode": "contain"
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "usesCleartextTraffic": true
          }
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "651bf4be-b310-4572-9620-b9ab4e4ea6b3"
      }
    },
    "owner": "swetha-ks"
  }
}



